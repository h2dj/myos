# 로컬 개발용 Postgres (docker compose up -d db)
DATABASE_URL=postgres://myos:myos@localhost:5432/myos

# 인증 모드: 비워두면 Supabase. 로컬 개발·E2E 테스트는 dev (운영 빌드에서는 거부됨)
AUTH_MODE=dev
DEV_AUTH_SECRET=change-me

# Supabase (이메일+비밀번호 인증)
NEXT_PUBLIC_SUPABASE_URL=
# Connect 대화상자 또는 Settings > API Keys의 publishable 키 (sb_publishable_…)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# (기존 프로젝트) legacy anon 키도 동작하지만 2026년 말 폐지 예정
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 이메일 알림 (Resend). 비워두면 앱 내 알림만
# 이메일 본문 링크용 앱 주소
APP_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM=

# 기본 시간대
APP_TIMEZONE=Asia/Seoul
