{
  "name": "myos",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @myos/web dev",
    "dev:worker": "pnpm --filter @myos/worker dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d db",
    "db:generate": "pnpm --filter @myos/db generate",
    "db:migrate": "pnpm --filter @myos/db migrate",
    "db:check": "pnpm --filter @myos/db check",
    "backup:verify": "pnpm --filter @myos/domain --silent backup:verify",
    "backup:rehearse": "pnpm --filter @myos/domain --silent backup:rehearse",
    "perf:benchmark": "pnpm --filter @myos/domain --silent perf:benchmark",
    "perf:report": "pnpm --filter @myos/domain --silent perf:report"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
